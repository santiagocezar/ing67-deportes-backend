{
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "SignupRequest": {
        "additionalProperties": false,
        "properties": {
          "birthdate": {
            "format": "date",
            "title": "Birthdate",
            "type": "string"
          },
          "email": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "name",
          "birthdate",
          "email",
          "password"
        ],
        "title": "SignupRequest",
        "type": "object"
      },
      "SignupResponse": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "message",
          "user"
        ],
        "title": "SignupResponse",
        "type": "object"
      },
      "SportCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "max_players": {
            "maximum": 20,
            "minimum": 1.0,
            "title": "Max Players",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "max_players"
        ],
        "title": "SportCreateRequest",
        "type": "object"
      },
      "SportEnvelope": {
        "properties": {
          "sport": {
            "$ref": "#/components/schemas/SportResponse"
          }
        },
        "required": [
          "sport"
        ],
        "title": "SportEnvelope",
        "type": "object"
      },
      "SportListResponse": {
        "properties": {
          "sports": {
            "items": {
              "$ref": "#/components/schemas/SportResponse"
            },
            "title": "Sports",
            "type": "array"
          }
        },
        "required": [
          "sports"
        ],
        "title": "SportListResponse",
        "type": "object"
      },
      "SportResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "max_players": {
            "title": "Max Players",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "max_players"
        ],
        "title": "SportResponse",
        "type": "object"
      },
      "SportUpdateRequest": {
        "additionalProperties": false,
        "properties": {
          "max_players": {
            "anyOf": [
              {
                "maximum": 20,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "readOnly": true,
            "title": "Max Players"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "SportUpdateRequest",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_expires_in": {
            "title": "Access Expires In",
            "type": "integer"
          },
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "access_expires_in"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserEnvelope": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "user"
        ],
        "title": "UserEnvelope",
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "birthdate": {
            "format": "date",
            "title": "Birthdate",
            "type": "string"
          },
          "creation_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Creation Date"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "birthdate",
          "role",
          "email",
          "creation_date"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidationDetail": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message",
          "type"
        ],
        "title": "ValidationDetail",
        "type": "object"
      },
      "ValidationErrorModel": {
        "properties": {
          "ctx": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "An optional object which contains values required to render the error message.",
            "title": "Error context"
          },
          "input": {
            "description": "The input provided for validation.",
            "title": "Input"
          },
          "loc": {
            "description": "The error's location as a list.",
            "items": {},
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "description": "A human readable explanation of the error.",
            "title": "Message",
            "type": "string"
          },
          "type": {
            "description": "A computer-readable identifier of the error type.",
            "title": "Error Type",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The URL to further information about the error.",
            "title": "URL"
          }
        },
        "required": [
          "type",
          "loc",
          "msg",
          "input"
        ],
        "title": "ValidationErrorModel",
        "type": "object"
      }
    },
    "securitySchemes": {
      "AccessTokenAuth": {
        "bearerFormat": "JWT",
        "description": "JWT access token. It expires after 15 minutes.",
        "scheme": "bearer",
        "type": "http"
      },
      "RefreshTokenAuth": {
        "bearerFormat": "JWT",
        "description": "Rotating JWT refresh token. Use it only for refresh or logout.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "summary": "Authentication and sports management API.",
    "title": "Sports App API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "description": "Validates credentials and returns a 15-minute access token plus a rotating refresh token.",
        "operationId": "authLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Start an authenticated session",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/logout": {
      "delete": {
        "description": "Accepts either token type and revokes its persistent session.",
        "operationId": "authLogout",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "AccessTokenAuth": []
          },
          {
            "RefreshTokenAuth": []
          }
        ],
        "summary": "Revoke the current session",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "description": "Requires a valid access token.",
        "operationId": "authMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEnvelope"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "AccessTokenAuth": []
          }
        ],
        "summary": "Get the authenticated user",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Requires the current refresh token. It is invalidated and replaced with a new access/refresh pair; reuse revokes the whole session.",
        "operationId": "authRefresh",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "RefreshTokenAuth": []
          }
        ],
        "summary": "Rotate a refresh token",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/signup": {
      "post": {
        "description": "Creates a public account with the referee role.",
        "operationId": "authSignup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
