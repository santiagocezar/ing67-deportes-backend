SQLALCHEMY_DATABASE_URI=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
CORS_ORIGINS=http://localhost:5173
API_DOCS_ENABLED=true
# Optional persistent local storage for a single backend instance. Defaults to
# instance/player_photos and must be backed up together with PostgreSQL.
# PLAYER_PHOTOS_DIR=C:/absolute/path/to/player_photos
